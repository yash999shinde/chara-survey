<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Farmers Dashboard</title>
<style>
body{font-family:Arial;background:#f4f6f8;color:#202938;margin:0}
header{background:#183b32;color:white;padding:22px 5%}
main{max-width:1100px;margin:24px auto;padding:0 16px}
.panel,.record{background:white;padding:16px;margin:14px 0;border-radius:10px}
a,button{background:#176b50;color:white;border:0;padding:10px 14px;border-radius:6px;text-decoration:none;cursor:pointer}
.msg{background:#e4f7e9;padding:12px}.err{background:#ffe6e6;padding:12px}
pre{white-space:pre-wrap;overflow-wrap:anywhere}
</style>
</head>
<body>
<header><h1>Farmers Details</h1><p>Upload → Review → Approve → Excel</p></header>
<main>
<p><a href="/">Main Dashboard</a> <a href="/upload">Upload Survey / OCR</a> <a href="/farmers/export.xlsx">Export Excel</a></p>
{% if message %}<p class="msg">{{ message }}</p>{% endif %}
{% if error %}<p class="err">{{ error }}</p>{% endif %}
<section class="panel">
<h2>Upload Farmers List</h2>
<p>CSV/Excel file mein English headers farmer_name, village_name, mobile aur baaki field names hone chahiye.</p>
<form method="post" enctype="multipart/form-data">
<input type="hidden" name="action" value="upload">
<input type="file" name="file" accept=".csv,.xlsx,.xlsm" required>
<button>Upload for review</button>
</form>
</section>
<h2>Pending review ({{ pending|length }})</h2>
{% for r in pending %}
<section class="record">
<strong>Import #{{ r.id }}</strong> — {{ r.source_file }}
<pre>{{ r.data | tojson(indent=2) }}</pre>
<form method="post" style="display:inline">
<input type="hidden" name="staging_id" value="{{ r.id }}">
<button name="action" value="approve">Approve row</button>
<button name="action" value="reject">Reject row</button>
</form>
</section>
{% else %}<p class="panel">Koi pending import nahi hai.</p>{% endfor %}
<h2>Saved farmers ({{ farmers|length }} shown)</h2>
{% for f in farmers %}
<section class="record">
<strong>#{{ f.id }} — {{ f.farmer_name or 'Name missing' }}</strong>
<p>Village: {{ f.village_name or '—' }} | Mobile: {{ f.mobile or '—' }} | Status: {{ f.status }}</p>
</section>
{% else %}<p class="panel">Abhi approved farmer records nahi hain.</p>{% endfor %}
</main></body></html>
