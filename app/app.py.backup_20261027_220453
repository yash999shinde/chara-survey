        "sheep_migratory", "sheep_confined", "green_fodder_tonnes",
        "silage_tonnes", "dry_fodder_tonnes", "fodder_for_sale_tonnes",
        "rabi_area_hectares",
    }

    def prefill(record):
        values = {f: "" for f in FIELDS}
        values.update(DEFAULTS)
        lines = [re.sub(r"\s+", " ", x).strip()
                 for x in str(record.get("raw_text", "")).splitlines()]

        for field, aliases in ALIASES.items():
            for i, line in enumerate(lines):
                for alias in sorted(aliases, key=len, reverse=True):
                    pos = line.casefold().find(alias.casefold())
                    if pos < 0:
                        continue

                    tail = line[pos + len(alias):].strip(" :?=-|")
                    if not tail and i + 1 < len(lines):
                        tail = lines[i + 1].strip(" :?=-|")

                    if field in NUMERIC:
                        m = re.search(r"-?\d+(?:[.,]\d+)?", tail)
                        if m:
                            values[field] = m.group().replace(",", ".")
                    elif field == "mobile":
                        m = re.search(r"(?<!\d)[6-9]\d{9}(?!\d)", tail)
                        if m:
                            values[field] = m.group()
                    elif tail:
                        values[field] = tail[:120]

                    if values.get(field):
                        break
                if values.get(field):
                    break

        mobiles = record.get("mobile_candidates", [])
        if not values.get("mobile") and len(mobiles) == 1:
            values["mobile"] = re.sub(r"\D", "", str(mobiles[0]))[-10:]

        return values

    if request.method == "POST":
        rid = request.form.get("candidate_id", "")
        record = next(
            (r for r in records if str(r.get("candidate_id", "")) == rid),
            None,
        )
        if not record:
            return "Unknown candidate ID.", 400

        action = request.form.get("action", "save_review")
        if action not in {"save_review", "stage_farmer"}:
            return "Unknown action.", 400

        status = request.form.get("status", "pending")
        if status not in {"pending", "verified", "needs_correction"}:
            status = "pending"

        previous = reviews.get(rid, {})
        old = previous.get("farmer_fields") or prefill(record)
        fields = {
            f: request.form.get(f, old.get(f, "")).strip()
            for f in FIELDS
        }

        entry = {
            "status": status,
            "corrected_text": request.form.get(
                "corrected_text", previous.get("corrected_text", record.get("raw_text", ""))
            ),
            "note": request.form.get("note", previous.get("note", "")),
            "farmer_fields": fields,
            "stage_message": "",
        }

        if action == "stage_farmer":
            if status != "verified":
                entry["stage_message"] = "Original PDF verify karo aur Verified by reviewer select karo."
            elif not fields.get("farmer_name") or not fields.get("village_name"):
                entry["stage_message"] = "Farmer name aur village name required hain."
            else:
                source_name = f"OCR:{rid}:{record.get('source_file', 'unknown')}"
                row_json = json.dumps(fields, ensure_ascii=False)
