def connect_db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DB_PATH)
    db.row_factory = sqlite3.Row
    return db


def init_db():
    with connect_db() as db:
        db.execute("""
            CREATE TABLE IF NOT EXISTS reviews (
                source_file TEXT NOT NULL,
                record_id TEXT NOT NULL,
                record_json TEXT NOT NULL,
                original_status TEXT NOT NULL,
                decision TEXT,
                reviewer_note TEXT NOT NULL DEFAULT '',
                updated_at TEXT,
                PRIMARY KEY (source_file, record_id)
            )
        """)


def import_latest_report():
    reports = sorted(
        REPORT_DIR.glob("*_dry_run.csv"),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )

    if not reports:
        return

    source = reports[0]

    with source.open(
        "r",
        encoding="utf-8-sig",
        newline="",
    ) as file:
        rows = list(csv.DictReader(file))

    with connect_db() as db:
        for row in rows:
            record_id = (row.get("record_id") or "").strip()

            if not record_id:
                continue

            # Never overwrite an existing review decision.
            db.execute("""
                INSERT OR IGNORE INTO reviews (
                    source_file,
                    record_id,
                    record_json,
                    original_status
                )
                VALUES (?, ?, ?, ?)
            """, (
                source.name,
                record_id,
                json.dumps(row, ensure_ascii=False),
                row.get("status", "needs_review"),
            ))


@app.get("/")
def index():
    import_latest_report()

    selected_status = request.args.get("status", "all")

    with connect_db() as db:
        rows = db.execute("""
            SELECT *
            FROM reviews
            ORDER BY source_file, record_id
        """).fetchall()

    records = []

    for row in rows:
        record = dict(row)
        record["fields"] = json.loads(record["record_json"])
        record["display_status"] = (
            record["decision"] or record["original_status"]
        )

        if (
            selected_status == "all"
            or record["display_status"] == selected_status
        ):
            records.append(record)

    counts = {
        "total": len(rows),
        "pending": sum(row["decision"] is None for row in rows),
        "verified": sum(
            row["decision"] == "verified" for row in rows
        ),
        "needs_review": sum(
            row["decision"] == "needs_review"
            or (
                row["decision"] is None
                and row["original_status"] == "needs_review"
            )
            for row in rows
        ),
    }

    return render_template(
        "index.html",
        records=records,
        counts=counts,
        selected_status=selected_status,
    )


@app.post("/review")
def review():
    source_file = request.form.get("source_file", "")
    record_id = request.form.get("record_id", "")
    decision = request.form.get("decision", "")
    note = request.form.get("reviewer_note", "").strip()[:1000]

    if decision not in {"verified", "needs_review"}:
        abort(400, "Invalid review decision.")

    with connect_db() as db:
        result = db.execute("""
            UPDATE reviews
            SET decision = ?,
                reviewer_note = ?,
                updated_at = ?
            WHERE source_file = ? AND record_id = ?
        """, (
            decision,
            note,
            datetime.now(timezone.utc).isoformat(),
            source_file,
            record_id,
        ))

        if result.rowcount != 1:
            abort(404, "Record not found.")

    return redirect(url_for("index"))


@app.get("/export")
def export_csv():
    with connect_db() as db:
        rows = db.execute("""
            SELECT source_file, record_id, record_json,
                   original_status, decision, reviewer_note, updated_at
            FROM reviews
            ORDER BY source_file, record_id
        """).fetchall()

    output = io.StringIO()
    writer = csv.writer(output)

    writer.writerow([
        "source_file",
        "record_id",
        "original_status",
        "review_decision",
        "reviewer_note",
        "updated_at",
        "record_data_json",
    ])

    for row in rows:
        writer.writerow([
            row["source_file"],
            row["record_id"],
            row["original_status"],
            row["decision"] or "",
            row["reviewer_note"],
            row["updated_at"] or "",
            row["record_json"],
        ])

    return Response(
        "\ufeff" + output.getvalue(),
        mimetype="text/csv; charset=utf-8",
        headers={
            "Content-Disposition":
                "attachment; filename=chara_survey_review.csv"
        },
    )


@app.get("/export.xlsx")
def export_excel():
    with connect_db() as db:
        rows = db.execute("""
            SELECT source_file, record_id, record_json,
                   original_status, decision, reviewer_note, updated_at
            FROM reviews
            ORDER BY source_file, record_id
        """).fetchall()

    workbook = Workbook()
    sheet = workbook.active
    sheet.title = "Survey Review"

    sheet.append([
        "Source File",
        "Record ID",
        "Original Status",
        "Review Decision",
        "Reviewer Note",
        "Updated At",
        "Record Data JSON",
    ])

    for row in rows:
        sheet.append([
            row["source_file"],
            row["record_id"],
            row["original_status"],
            row["decision"] or "",
            row["reviewer_note"],
            row["updated_at"] or "",
            row["record_json"],
        ])

    output = io.BytesIO()
    workbook.save(output)
    output.seek(0)

    return send_file(
        output,
        as_attachment=True,
        download_name="chara_survey_review.xlsx",
        mimetype=(
            "application/vnd.openxmlformats-officedocument."
            "spreadsheetml.sheet"
        ),
    )


