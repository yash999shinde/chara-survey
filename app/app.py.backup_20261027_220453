                        ).fetchone()

                        if exists:
                            entry["stage_message"] = f"Record already pending as ID {exists[0]}."
                        else:
                            cur = conn.execute(
                                """INSERT INTO farmer_import_staging
                                   (source_file, row_json, status)
                                   VALUES (?, ?, 'pending')""",
                                (source_name, row_json),
                            )
                            entry["stage_message"] = (
                                f"Pending review mein add hua, staging ID {cur.lastrowid}. "
                                "Final approval Farmers dashboard par karna hoga."
                            )
                except Exception as exc:
                    entry["stage_message"] = f"Staging error: {exc}"

        reviews[rid] = entry
        review_file.write_text(
            json.dumps(reviews, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        return redirect(url_for("ocr_review_dashboard"))

