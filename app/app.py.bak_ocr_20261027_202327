# Document upload: files are stored locally; no external submission occurs.
UPLOAD_DIR = Path(__file__).resolve().parents[1] / "data" / "uploads"
OCR_OUTPUT_DIR = Path(__file__).resolve().parents[1] / "data" / "ocr_output"
ALLOWED_UPLOAD_EXTENSIONS = {".pdf", ".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp"}

app.config["MAX_CONTENT_LENGTH"] = 15 * 1024 * 1024


@app.route("/upload", methods=["GET", "POST"])
def upload_document():
    UPLOAD_DIR.mkdir(parents=True, exist_ok=True)
    OCR_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

    if request.method == "GET":
        return render_template("upload.html")

    uploaded = request.files.get("document")
    if uploaded is None or not uploaded.filename:
        return render_template(
            "upload.html", error="Please select a PDF or image file."
        ), 400

    safe_name = secure_filename(uploaded.filename)
    extension = Path(safe_name).suffix.lower()

    if not safe_name or extension not in ALLOWED_UPLOAD_EXTENSIONS:
        return render_template(
            "upload.html",
            error="Unsupported file type. Choose a PDF or supported image."
        ), 400

    stored_name = f"{uuid.uuid4().hex}{extension}"
    destination = UPLOAD_DIR / stored_name
    uploaded.save(destination)

    try:
        from ingestion.ocr_engine import extract_text

        result = extract_text(destination, language="mar+eng")
        text_path = OCR_OUTPUT_DIR / f"{Path(stored_name).stem}.txt"
        text_path.write_text(result["full_text"], encoding="utf-8")

        return render_template(
            "upload.html",
            message="Upload and OCR completed. Review the extracted text before using it.",
            uploaded_name=safe_name,
            extracted_text=result["full_text"],
            page_count=result["page_count"],
        )
    except Exception as exc:
        # Keep the uploaded file for later processing; do not discard it.
        return render_template(
            "upload.html",
            message="File saved locally, but OCR could not run yet.",
            uploaded_name=safe_name,
            error=str(exc),
        )


@app.errorhandler(413)
def upload_too_large(_error):
    return render_template(
        "upload.html",
        error="File is too large. Maximum upload size is 15 MB."
    ), 413




@app.route("/ocr-review", methods=["GET", "POST"])
def ocr_review_dashboard():
    import json
    from pathlib import Path
    from flask import request

    processed_dir = Path(__file__).resolve().parents[1] / "data" / "processed"
    processed_dir.mkdir(parents=True, exist_ok=True)

    files = sorted(
        processed_dir.glob("*_candidates.json"),
        key=lambda f: f.stat().st_mtime,
        reverse=True,
    )
    if not files:
        return "No OCR candidate file found.", 404

    candidate_file = files[0]
    records = json.loads(candidate_file.read_text(encoding="utf-8"))
    review_file = processed_dir / f"{candidate_file.stem}_review.json"
    reviews = json.loads(review_file.read_text(encoding="utf-8")) if review_file.exists() else {}

    if request.method == "POST":
        rid = request.form.get("candidate_id", "")
        if rid not in {str(r.get("candidate_id", "")) for r in records}:
            return "Unknown candidate ID.", 400

        status = request.form.get("status", "pending")
        if status not in {"pending", "verified", "needs_correction"}:
            status = "pending"

        reviews[rid] = {
            "status": status,
            "corrected_text": request.form.get("corrected_text", ""),
            "note": request.form.get("note", ""),
        }
        review_file.write_text(
            json.dumps(reviews, ensure_ascii=False, indent=2),
            encoding="utf-8",
        )
        return redirect(url_for("ocr_review_dashboard"))

    return render_template(
        "ocr_review.html",
        records=records,
        reviews=reviews,
        source_name=candidate_file.name,
    )


